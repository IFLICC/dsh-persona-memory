{
  "name": "@local/dsh-persona-memory",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "description": "Persona mode with configurable character cards and behavior weights, Ebbinghaus-style memory, diaries, and a reference library.",
  "author": "ifenc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifenc/dsh-persona-memory.git"
  },
  "homepage": "https://github.com/ifenc/dsh-persona-memory#readme",
  "bugs": {
    "url": "https://github.com/ifenc/dsh-persona-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "memory",
    "ebbinghaus",
    "diary",
    "library",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/store.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
